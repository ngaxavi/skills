<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ngaxavi</groupId>
    <artifactId>skills</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>skills</name>
    <description>Domain-specific agent skills for JVM AI agents and code assistants.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          allowed-tools must mirror the frontmatter of each SKILL.md exactly.
          The SkillsJars plugin validates these against the SKILL.md and fails
          the build on any mismatch. Keep this in sync when you edit a skill.
        -->
        <skillsjars.skill.kubernetes-troubleshooting.allowed-tools>Bash Read Grep</skillsjars.skill.kubernetes-troubleshooting.allowed-tools>
    </properties>

    <!--
      SCM lets the plugin derive the <org>/<repo> segment of the skill path
      (META-INF/skills/<org>/<repo>/<skill>/) from the GitHub URL. Update the
      URL to your actual repository before publishing.
    -->
    <scm>
        <url>https://github.com/ngaxavi/skills</url>
        <connection>scm:git:https://github.com/ngaxavi/skills.git</connection>
    </scm>

    <build>
        <plugins>
            <plugin>
                <groupId>com.skillsjars</groupId>
                <artifactId>maven-plugin</artifactId>
                <version>0.0.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Enforce the SKILL.md line budget on `mvn verify`. The body loads into
              the model's context on every skill trigger, so the spine stays lean and
              depth lives in references/. Raising the budget is a deliberate edit to
              scripts/check-skill-size.sh, not an accident.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>check-skill-size</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/check-skill-size.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
